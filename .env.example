# Supabase (client-side: URL + anon/publishable key only)
# Copy to .env for local reference. Flutter does not load .env at runtime; pass values via --dart-define or env vars.
# Never commit a real .env if it contains secrets; this example matches the project Supabase project.
#
# Windows PowerShell (set once per session):
#   $env:SUPABASE_URL="https://tkhdemvsbzjiofgpnbcn.supabase.co"
#   $env:SUPABASE_ANON_KEY="sb_publishable_JTYcd8QOx7ZW5SEFyClFcA_uM7qB6Ax"
#   flutter run --dart-define=SUPABASE_URL=$env:SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$env:SUPABASE_ANON_KEY
#   flutter build appbundle --release --dart-define=SUPABASE_URL=$env:SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$env:SUPABASE_ANON_KEY
# Linux/macOS: export SUPABASE_URL=... SUPABASE_ANON_KEY=...
# Detaylı AAB: BUILD_AAB.md

SUPABASE_URL=https://tkhdemvsbzjiofgpnbcn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_JTYcd8QOx7ZW5SEFyClFcA_uM7qB6Ax

# Database password: do NOT put in app. Use only for direct Postgres (migrations, admin)
# Store in password manager. Connection: postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
