#   flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#   flutter run --dart-define=SUPABASE_URL=https://tkhdemvsbzjiofgpnbcn.supabase.co --dart-define=SUPABASE_ANON_KEY=sb_publishable_JTYcd8QOx7ZW5SEFyClFcA_uM7qB6Ax
#   flutter build appbundle --release --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

SUPABASE_URL=https://tkhdemvsbzjiofgpnbcn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_JTYcd8QOx7ZW5SEFyClFcA_uM7qB6Ax

# Database password: do NOT put in app. Use only for direct Postgres (migrations, admin)
