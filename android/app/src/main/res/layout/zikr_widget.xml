<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:clickable="false"
    android:focusable="false"
    android:elevation="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zikirmatik"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/widget_counter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="0"
        android:textSize="56sp"
        android:textColor="#FFD700"
        android:textStyle="bold"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6" />

    <!-- Statistics removed: only main counter and buttons -->

    <!-- Statistics removed: only main counter is shown -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginTop="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_increment"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="+1"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp" />

        <TextView
            android:id="@+id/widget_reset"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="↻"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#E74C3C"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp" />

    </LinearLayout>

</LinearLayout>
